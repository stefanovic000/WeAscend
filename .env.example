# Server-only MongoDB Atlas connection. Never prefix this with VITE_ or NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ascend

# Firebase Authentication. These values come from Firebase Console > Project settings > Web app.
# The web configuration values identify the Firebase project; they are not admin credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Optional custom Firebase action emails delivered through Resend. These are server-only secrets.
# Keep AUTH_EMAIL_PROVIDER unset until every value below is configured and tested.
# AUTH_EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# AUTH_EMAIL_FROM=WeAscend <account@your-domain.example>
# AUTH_EMAIL_REPLY_TO=support@your-domain.example
# APP_BASE_URL=https://your-weascend-domain.example
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-...@your-project.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# AUTH_EMAIL_RATE_LIMIT_SECRET=generate-a-long-random-secret

# Permanent Android application ID.
ANDROID_APPLICATION_ID=com.wesystemlabs.weascend

# Optional server-only DeepSeek XP advisor. The app works normally without it.
# Never expose this key through VITE_ or NEXT_PUBLIC_ variables.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-v4-flash

# AI safeguards are implemented but intentionally disabled for initial testers.
AI_LIMITS_ENABLED=false
AI_XP_DAILY_LIMIT=20
AI_BOSS_STEPS_DAILY_LIMIT=5
AI_COOLDOWN_SECONDS=10

# Grants every authenticated closed-beta tester Premium without enabling billing.
# Keep AI_LIMITS_ENABLED=false while tester quotas are informational only.
PREMIUM_BETA_ACCESS=false
