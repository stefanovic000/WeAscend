# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
.vinext/
out/

# misc
.DS_Store
*.pem
*.jks
*.keystore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/apps/*/dist/
.wrangler/
/outputs/
/work/
/.npm-cache/
/.dev-*.log
/.dev-pid

# Android / Bubblewrap generated build output
/android-twa/.gradle/
/android-twa/app/build/
/android-twa/build/
/android-twa/decompressed/
/android-twa/app-release-*.apk
/android-twa/app-release-*.aab
/android-twa/*.idsig
/android-twa/local.properties

# Expo / React Native mobile development output
/apps/mobile/node_modules/
/apps/mobile/.expo/
/apps/mobile/dist/
/apps/mobile/android/
/apps/mobile/ios/
*.mobileprovision

# Locally generated install packages
/builds/*.apk
