{
  "name": "weascend-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix apps/web install && npm --prefix apps/mobile install",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "preview": "npm --prefix apps/web run preview",
    "start": "npm --prefix apps/web run start",
    "test": "npm --prefix apps/web test",
    "lint": "npm --prefix apps/web run lint",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "android:check": "node scripts/android-check.mjs",
    "android:assetlinks": "node scripts/android-assetlinks.mjs"
  }
}
